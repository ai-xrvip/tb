# 4KHD Gallery Search Bot Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your-bot-token-here

# Search settings
MAX_SEARCH_RESULTS=10
MAX_PAGES_PER_POST=5
MAX_IMAGES_PER_POST=30

# Cache TTL in seconds
CACHE_TTL=300
CACHE_MAX_ENTRIES=500

# Rate limiting
MAX_SEARCHES_PER_MINUTE=10

# Free tier: daily search quota for non-VIP users (0 = unlimited)
FREE_DAILY_SEARCHES=10
# Free trial days granted on first /start (0 = disabled)
FREE_TRIAL_DAYS=1
# VIP pricing line shown in paywall copy: 首月体验 ¥9.9 / 月卡 ¥19.9 / 季卡 ¥49 / 年卡 ¥129 / 永久 ¥299（限时）
VIP_PRICE_TEXT=首月体验 ¥9.9 | 月卡 ¥19.9 | 季卡 ¥49 | 年卡 ¥129 | 永久 ¥299（限时）
# Free tier: images visible per gallery for non-VIP users
FREE_PREVIEW_IMAGES=5
# Scale/marketing line shown on the start screen
SCALE_TEXT=📚 已收录 90万+ 套图集 · 3800万+ 张高清图片 · 每日更新

# Admin user IDs (comma-separated)
ADMIN_IDS=123456789

# Webhook (leave empty for polling mode)
WEBHOOK_URL=
WEBHOOK_PORT=8000

# SSL verification
SSL_VERIFY=true

# E-Hentai cookies (for cosplay gallery search)
EH_MEMBER_ID=
EH_PASS_HASH=
EH_SK=
EH_EVENT=
EH_IQ=

# Database path (SQLite, default: data/bot.db)
DB_PATH=data/bot.db

# Web admin dashboard token (set a random string to secure the dashboard)
ADMIN_WEB_TOKEN=
